        "!pip install -q chromadb\n",
        "\n",
        "import chromadb\n",
        "\n",
        "client = chromadb.Client()\n",
        "\n",
        "collection = client.get_or_create_collection(\n",
        "    name=\"crud_demo\"\n",
        ")\n",
        "\n",
        "collection.add(\n",
        "    documents=[\n",
        "        \"Python is a popular programming language for AI.\",\n",
        "        \"The weather today is sunny and warm.\",\n",
        "        \"Machine learning models learn patterns from data.\",\n",
        "        \"I enjoy playing football on weekends.\",\n",
        "        \"Deep learning uses neural networks with many layers.\"\n",
        "    ],\n",
        "    metadatas=[\n",
        "        {\"category\": \"tech\"},\n",
        "        {\"category\": \"weather\"},\n",
        "        {\"category\": \"tech\"},\n",
        "        {\"category\": \"sports\"},\n",
        "        {\"category\": \"tech\"}\n",
        "    ],\n",
        "    ids=[\"doc1\", \"doc2\", \"doc3\", \"doc4\", \"doc5\"]\n",
        ")\n",
        "\n",
        "print(\"Collection:\", collection.name)\n",
        "print(\"Current document count:\", collection.count())\n",
        "\n",
        "preview = collection.peek(limit=3)\n",
        "\n",
        "print(\"\\nPeek:\")\n",
        "for doc_id, doc in zip(\n",
        "    preview[\"ids\"],\n",
        "    preview[\"documents\"]\n",
        "):\n",
        "    print(doc_id, \"->\", doc)\n",
        "\n",
        "result = collection.get(\n",
        "    ids=[\"doc1\", \"doc3\"]\n",
        ")\n",
        "\n",
        "print(\"\\nGet by ID:\")\n",
        "for doc_id, doc, meta in zip(\n",
        "    result[\"ids\"],\n",
        "    result[\"documents\"],\n",
        "    result[\"metadatas\"]\n",
        "):\n",
        "    print(f\"{doc_id} | {meta} | {doc}\")\n",
        "\n",
        "results = collection.query(\n",
        "    query_texts=[\"Tell me about AI and neural networks\"],\n",
        "    n_results=2\n",
        ")\n",
        "\n",
        "print(\"\\nSemantic Search:\")\n",
        "\n",
        "for doc_id, doc, distance in zip(\n",
        "    results[\"ids\"][0],\n",
        "    results[\"documents\"][0],\n",
        "    results[\"distances\"][0]\n",
        "):\n",
        "    print(f\"{doc_id} | distance={distance:.4f} | {doc}\")\n",
        "\n",
        "results = collection.query(\n",
        "    query_texts=[\"something fun to do outside\"],\n",
        "    n_results=3,\n",
        "    where={\"category\": \"sports\"}\n",
        ")\n",
        "\n",
        "print(\"\\nFiltered Search:\")\n",
        "\n",
        "for doc_id, doc, distance in zip(\n",
        "    results[\"ids\"][0],\n",
        "    results[\"documents\"][0],\n",
        "    results[\"distances\"][0]\n",
        "):\n",
        "    print(f\"{doc_id} | distance={distance:.4f} | {doc}\")\n",
        "\n",
        "collection.update(\n",
        "    ids=[\"doc4\"],\n",
        "    documents=[\n",
        "        \"I enjoy playing football and basketball on weekends.\"\n",
        "    ],\n",
        "    metadatas=[\n",
        "        {\n",
        "            \"category\": \"sports\",\n",
        "            \"updated\": True\n",
        "        }\n",
        "    ]\n",
        ")\n",
        "\n",
        "updated = collection.get(\n",
        "    ids=[\"doc4\"]\n",
        ")\n",
        "\n",
        "print(\"\\nUpdated Document:\")\n",
        "print(updated[\"documents\"])\n",
        "print(updated[\"metadatas\"])\n",
        "\n",
        "collection.upsert(\n",
        "    documents=[\n",
        "        \"Deep learning uses neural networks with many layers and GPUs.\",\n",
        "        \"The Eiffel Tower is located in Paris.\"\n",
        "    ],\n",
        "    ids=[\"doc5\", \"doc6\"]\n",
        ")\n",
        "\n",
        "print(\"\\nAfter Upsert:\")\n",
        "print(\"Total count:\", collection.count())\n",
        "print(collection.get(ids=[\"doc5\", \"doc6\"])[\"documents\"])\n",
        "\n",
        "collection.delete(\n",
        "    ids=[\"doc2\"]\n",
        ")\n",
        "\n",
        "print(\"\\nAfter deleting doc2:\")\n",
        "print(\"Total count:\", collection.count())\n",
        "print(\"Remaining IDs:\", collection.get()[\"ids\"])\n",
        "\n",
        "collection.delete(\n",
        "    where={\"category\": \"tech\"}\n",
        ")\n",
        "\n",
        "print(\"\\nAfter deleting tech category:\")\n",
        "print(\"Total count:\", collection.count())\n",
        "print(\"Remaining IDs:\", collection.get()[\"ids\"])\n",
        "\n",
        "final_state = collection.get()\n",
        "\n",
        "print(\"\\nFinal State:\")\n",
        "print(\"Final document count:\", collection.count())\n",
        "\n",
        "for doc_id, doc, meta in zip(\n",
        "    final_state[\"ids\"],\n",
        "    final_state[\"documents\"],\n",
        "    final_state[\"metadatas\"]\n",
        "):\n",
        "    print(f\"{doc_id} | {meta} | {doc}\")\n",
        "\n",
        "print(\"\\nCRUD operations completed successfully!\")"
      ],
